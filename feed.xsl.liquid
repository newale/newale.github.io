<?xml version="1.0" encoding="utf-8"?>
<!--
  Hoja de estilos del feed: hace que /feed.xml se vea como una página del sitio
  cuando alguien lo abre en un navegador. Es XSLT 1.0 porque es lo único que los
  navegadores implementan. Si Chrome termina de retirar XSLT, /feed/
  sigue cumpliendo el mismo papel.
-->
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:atom="http://www.w3.org/2005/Atom"
  exclude-result-prefixes="atom">

  <xsl:output method="html" encoding="utf-8" indent="yes"/>

  <xsl:template match="/">
    <html lang="es-CL">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta name="robots" content="noindex"/>
        <title><xsl:value-of select="/atom:feed/atom:title"/></title>
        <link rel="icon" href="/static/imagenes/favicon.svg" type="image/svg+xml"/>
        <link rel="stylesheet" href="/static/css/sitio.css"/>
      </head>
      <body>
        {% include "components/nav.html" %}

        <div class="contenedor contenedor-lectura">
          <div class="aviso-feed">
            <p class="aviso-feed-titulo">Esto es un feed</p>
            <p>
              No está pensado para leerse acá: es la dirección que se pega en un lector
              de feeds para seguir el sitio sin depender de un algoritmo ni dejar un correo.
            </p>
            <p class="feed-url"><code>{{ site.url }}/feed.xml</code></p>
            <p>
              <a href="/feed/">¿Cómo se usa esto?</a> ·
              <a href="/">Ir al sitio</a>
            </p>
          </div>

          <h1><xsl:value-of select="/atom:feed/atom:title"/></h1>
          <p class="text-muted"><xsl:value-of select="/atom:feed/atom:subtitle"/></p>

          <span class="rotulo">Entradas</span>
          <div class="grid-tarjetas grid-dos">
            <xsl:for-each select="/atom:feed/atom:entry">
              <a class="card">
                <xsl:attribute name="href">
                  <xsl:value-of select="atom:link/@href"/>
                </xsl:attribute>
                <span class="card-kicker">
                  <xsl:value-of select="substring(atom:updated, 1, 10)"/>
                </span>
                <span class="card-title"><xsl:value-of select="atom:title"/></span>
                <xsl:if test="atom:summary">
                  <p class="card-body"><xsl:value-of select="atom:summary"/></p>
                </xsl:if>
                <xsl:if test="atom:category">
                  <span class="card-tags">
                    <xsl:for-each select="atom:category">
                      <span class="tag tag-outline"><xsl:value-of select="@term"/></span>
                    </xsl:for-each>
                  </span>
                </xsl:if>
              </a>
            </xsl:for-each>
          </div>

          <footer class="pie">
            <div class="pie-linea">
              <span>© 2026 AEBN — aebn.cl</span>
              <span>Santiago, Chile</span>
            </div>
          </footer>
        </div>
      </body>
    </html>
  </xsl:template>

</xsl:stylesheet>
